AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-2"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_PUBLIC_BASE_URL="https://your-public-cdn-or-s3-base-url"

REDIS_URL="redis://localhost:6379"
OPENROUTER_API_KEY=your-openrouter-key
