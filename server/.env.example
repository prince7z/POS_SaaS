PSQL="postgresql://USER:PASSWORD@HOST:5432/pos_saas?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
