PSQL="postgresql://USER:PASSWORD@HOST:5432/pos_saas?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
# Testing only. Never enable this in production.
TEST_AUTH_BYPASS="true"
# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3="https://brtech"
AWS_ACCESS_KEY_ID="na"
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-2"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_PUBLIC_BASE_URL="https://your-public-cdn-or-s3-base-url"

REDIS_URL="redis://localhost:6379"
EMAIL_FROM="no-reply@example.com"
FRONTEND_URL="http://localhost:5173"
BREVO_API_KEY="your-brevo-api-key"

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=POS SaaS

# ── Demo Seeder ──────────────────────────────────────────────────────────────
# Set DEMO_SEED_ENABLED=true to allow the demo seeder to run.
# Never enable in production without deliberate intent.
DEMO_SEED_ENABLED=false
DEMO_SEED_ID=salesakart-demomart-v1
DEMO_COMPANY_EMAIL=demomart@example.test
DEMO_ADMIN_EMAIL=admin@demomart.example.test
# Set a strong password — never commit the real value to source control.
DEMO_ADMIN_PASSWORD=<configure-outside-source-control>
DEMO_RANDOM_SEED=salesakart-demo-v1
DEMO_MEDIA_PREFIX=demo
# Set DEMO_SEED_RESET=true (or pass --reset flag) to delete and recreate demo data.
DEMO_SEED_RESET=false

ACCESS_TOKEN_TTL="24h"